# Untuk server yang SUDAH punya NGINX (mis. dipakai aplikasi lain). Jangan memakai profil "https" (Caddy).
# Salin ke /etc/nginx/sites-available/superapp, ganti nama domain, aktifkan, lalu pasang sertifikat:
#   sudo ln -s /etc/nginx/sites-available/superapp /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d superapp.example.com
server {
    listen 80;
    server_name superapp.example.com;

    client_max_body_size 22m;

    location / {
        proxy_pass http://127.0.0.1:3200;   # FRONTEND_PORT
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 130s;
    }
}
