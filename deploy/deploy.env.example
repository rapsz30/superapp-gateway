# Salin menjadi deploy/deploy.env (tidak masuk git), lalu isi. Jangan menaruh sandi atau kunci di sini.
# Alias dari ~/.ssh/config atau pengguna@alamat. Masuk memakai kunci SSH.
SSH_HOST=nama-alias-ssh
# Folder di server (relatif terhadap folder rumah pengguna SSH).
REMOTE_DIR=superapp
# Proxy HTTPS: "caddy" (server kosong; port 80/443 belum dipakai) atau "ada" (server sudah punya NGINX).
PROXY=ada
DOMAIN=superapp.example.com
# Port di server, hanya 127.0.0.1. Ganti bila bentrok dengan aplikasi lain.
GATEWAY_PORT=8080
FRONTEND_PORT=3200
