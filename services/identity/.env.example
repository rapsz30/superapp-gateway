# Salin menjadi .env lalu isi. Jangan commit .env.

# --- Database identity (dipakai image postgres dan layanan) ---
POSTGRES_DB=identity
POSTGRES_USER=identity
POSTGRES_PASSWORD=ganti-dengan-sandi-database
DATABASE_URL=postgresql+psycopg2://identity:ganti-dengan-sandi-database@identity-db:5432/identity

# --- JWT ---
# WAJIB sama dengan JWT_SECRET di services/microcred/.env selama token Micro-cred masih diterima
# gateway. Minimal 32 karakter. Layanan menolak start bila kosong atau memakai nilai bawaan.
# Buat: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=superapp-identity
ACCESS_TOKEN_MENIT=15
REFRESH_TOKEN_HARI=7

# --- Rahasia internal gateway <-> identity ---
# Dipakai verifier untuk memeriksa versi token akun. Wajib sama di sisi verifier (compose memuat berkas ini).
# Buat: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_TOKEN=

# --- Pengajuan rencana studi ke dosen pembimbing akademik ---
# Layanan matkul (langkah AI). Token WAJIB sama dengan MATKUL_SERVICE_TOKEN di services/matkul/.env.local.
MATKUL_URL=http://matkul:3000
MATKUL_SERVICE_TOKEN=

# AlurKerja (Camunda REST). Isi ketiganya untuk mode AlurKerja (proses lengkap; dosen memutuskan di Tasklist).
# Kosong = mode lokal (identity menjalankan urutan langkah sendiri; dosen memutuskan lewat API; untuk pengembangan).
ALURKERJA_URL=
ALURKERJA_USERNAME=
ALURKERJA_PASSWORD=
ALURKERJA_PROCESS_KEY=perencanaan-studi-superapp
ALURKERJA_TENANT_ID=
# Pengguna yang menjadi ${initiator} (penerima tugas mahasiswa di BPMN). Kosong = ALURKERJA_USERNAME.
ALURKERJA_INITIATOR=
# Untuk AlurKerja lokal bersertifikat mkcert: jalur berkas rootCA.pem di dalam container.
ALURKERJA_CA_BUNDLE=

# --- Lain-lain ---
ZONA_WAKTU=Asia/Jakarta
PANDUAN_MAKS_MB=20
LOGIN_MAKS_GAGAL=5
LOGIN_JENDELA_DETIK=900
