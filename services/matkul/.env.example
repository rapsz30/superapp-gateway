# Salin menjadi .env.local. Jangan commit .env.local.

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# --- PocketBase (peninggalan, tidak lagi menjadi sumber kebenaran) ---
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# --- Basis data langkah proses AlurKerja (matkul-db) ---
POSTGRES_DB=matkul
POSTGRES_USER=matkul
POSTGRES_PASSWORD=ganti-dengan-sandi-database
DATABASE_URL=postgresql://matkul:ganti-dengan-sandi-database@matkul-db:5432/matkul

# --- Autentikasi layanan-ke-layanan ---
# Token yang dipakai connector AlurKerja memanggil /api/matkul/*. WAJIB sama dengan GATEWAY_TOKEN di
# alurkerja-connector/.env. Buat: python -c "import secrets; print(secrets.token_hex(32))"
MATKUL_SERVICE_TOKEN=
# Dipakai matkul memanggil endpoint /internal milik identity. WAJIB sama dengan INTERNAL_TOKEN di services/identity/.env.
INTERNAL_TOKEN=
# Pencatatan pemakaian AI. Token sama dengan AI_CATAT_TOKEN pada identity; kosong = mati.
AI_CATAT_TOKEN=
# URL identity; di Docker Compose diarahkan ke identity-api.
IDENTITY_URL=http://identity-api:8002
