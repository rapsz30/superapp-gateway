# Worker AlurKerja untuk superapp. Salin menjadi .env lalu isi. Jangan commit .env.

# --- AlurKerja (REST Camunda 7) ---
# Alamat AlurKerja yang terjangkau dari kontainer. Untuk instalasi lokal: https://alurkerja.local:8100
ALURKERJA_BASE_URL=https://alurkerja.local:8100
# Akun Basic Auth Camunda untuk jalur /engine-rest (sama dengan ALURKERJA_USERNAME/PASSWORD di services/identity/.env).
ALURKERJA_ET_USERNAME=
ALURKERJA_ET_PASSWORD=

# --- Layanan matkul (jaringan internal compose) ---
# Diisi otomatis oleh docker-compose: GATEWAY_URL=http://matkul:3000, TOPIC_PREFIX, ALURKERJA_PROCESS_NAME.
# Token layanan: WAJIB sama dengan MATKUL_SERVICE_TOKEN di services/matkul/.env.local.
GATEWAY_TOKEN=

# --- Worker ---
WORKER_ID=superapp-worker-1
WORKER_LOCK_MS=120000
WORKER_POLL_MS=3000
# Percobaan per tugas sebelum menjadi insiden, dan jeda antar percobaan (milidetik).
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_MS=30000
# Hanya untuk demo bila proses tidak mengirim email_mahasiswa.
DEMO_STUDENT_EMAIL=mahasiswa.demo@example.com
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
